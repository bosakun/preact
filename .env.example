# Local mode executes trusted bundled tasks and MuJoCo, not sponsor integrations.
PREACT_DATABASE_URL=sqlite:///.preact/preact.db
PREACT_ARTIFACTS_DIR=.preact/artifacts
PREACT_MODE=local
# Optional real local NVIDIA reasoning; never a cloud/GPU-simulator substitute.
# Set PREACT_MODE=local-model only after preparing and starting the owned runner.
PREACT_LOCAL_MODEL_URL=http://127.0.0.1:8125
PREACT_LOCAL_MODEL_MANIFEST=
PREACT_LOCAL_MODEL_KEY_FILE=
# Optional server-owned Policy JSON. Requests can only tighten safety/resource limits.
PREACT_SERVICE_POLICY_JSON={}
# Cloud mode: exact NVIDIA model IDs from the admitted Token Factory catalog.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
NEBIUS_STRONG_MODEL=
# Zero/unset prices mean unknown cost. Replace with verified non-negative USD rates.
NEBIUS_INPUT_USD_PER_MILLION=0
NEBIUS_OUTPUT_USD_PER_MILLION=0
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
CONTREE_API_KEY=
CONTREE_IMAGE=
ISAAC_ENDPOINT=
ISAAC_STRONG_ENDPOINT=
ISAAC_PYTHON=/isaac-sim/python.sh
COSMOS_ENDPOINT=
COSMOS_REPO_PATH=
COSMOS_REVISION=
COSMOS_PYTHON=python
WORKER_TOKEN=
WORKER_DATABASE_URL=sqlite:///.preact/worker-jobs.db
NEBIUS_ACCESS_TOKEN=
NEBIUS_PROJECT_ID=
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POSTGRES_PASSWORD=
