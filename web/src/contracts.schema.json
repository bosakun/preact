        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "check": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "uncertainty": {
          "default": 1,
          "title": "Uncertainty",
          "type": "number"
        },
        "disagreement": {
          "default": 0,
          "title": "Disagreement",
          "type": "number"
        }
