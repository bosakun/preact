    "ClaimDefinition": {
      "additionalProperties": false,
      "description": "Episode-independent meaning; capability matching never uses concrete IDs.",
      "properties": {
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "namespace": {
          "default": "metric",
          "title": "Namespace",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "check",
            "success",
            "risk"
          ],
          "title": "Kind",
          "type": "string"
        },
        "scope": {
          "default": "root_action",
          "enum": [
            "root_action",
            "action_sequence"
          ],
          "title": "Scope",
          "type": "string"
        },
        "temporal": {
          "default": "at_horizon",
          "enum": [
            "at_horizon",
            "through_horizon"
          ],
          "title": "Temporal",
          "type": "string"
        }
