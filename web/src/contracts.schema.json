            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Checks"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
